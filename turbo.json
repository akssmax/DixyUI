{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["scripts/generate-*.mjs"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev:types": {
      "cache": false,
      "persistent": true
    },
    "dev:metadata": {
      "cache": false,
      "persistent": true
    }
  }
}
