            "headingCase": { "enum": ["none", "uppercase", "small-caps"] },
            "headingTracking": {
              "type": "number",
              "title": "Heading tracking",
              "minimum": -0.05,
              "maximum": 0.2
            },
            "headingWeight": { "enum": [300, 400, 500, 600, 700, 800, 900] },
            "numerals": { "enum": ["proportional", "tabular", "oldstyle"] }
          },
          "required": [
