{
  "name": "@dixy-ui/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3000",
    "build": "node ../../scripts/generate-api.mjs && node ../../scripts/check-examples.mjs && vite build",
    "typecheck": "tsc --noEmit",
